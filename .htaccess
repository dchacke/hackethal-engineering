RewriteEngine On

## Redirect from engineering.dennishackethal.com to hackethalengineering.com
RewriteCond %{HTTP_HOST} ^engineering\.dennishackethal\.com$ [NC]
RewriteRule ^ https://hackethalengineering.com%{REQUEST_URI} [L,R=301]

## As per https://stackoverflow.com/a/26494983
##Force SSL

#Normal way (in case you need to deploy to NON-heroku)
RewriteCond %{HTTPS} !=on

#Heroku way
RewriteCond %{HTTP:X-Forwarded-Proto} !https

#If neither above conditions are met, redirect to https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

## Hide index.html from the URL
RewriteRule ^$ /index.html [L]
